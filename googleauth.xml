<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_GOOGLEAUTH</name>
    <element>googleauth</element>
    <version>1.10.1</version>
    <creationDate>July 2026</creationDate>
    <author>Tomilin Serhii</author>
    <copyright>Copyright (C) 2026 Tomilin Serhii. All rights reserved.</copyright>
    <license>GNU General Public License v2 or later</license>
    <description>PLG_SYSTEM_GOOGLEAUTH_XML_DESCRIPTION</description>

    <namespace path="src">Joomla\Plugin\System\Googleauth</namespace>

    <files>
        <folder plugin="googleauth">services</folder>
        <folder>src</folder>
        <folder>language</folder>
    </files>

    <languages folder="language">
        <language tag="en-GB">en-GB/plg_system_googleauth.ini</language>
        <language tag="en-GB">en-GB/plg_system_googleauth.sys.ini</language>
        <language tag="uk-UA">uk-UA/plg_system_googleauth.ini</language>
        <language tag="uk-UA">uk-UA/plg_system_googleauth.sys.ini</language>
        <language tag="ru-RU">ru-RU/plg_system_googleauth.ini</language>
        <language tag="ru-RU">ru-RU/plg_system_googleauth.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic" label="PLG_SYSTEM_GOOGLEAUTH_FIELDSET_BASIC">
                <field
                    name="client_id"
                    type="text"
                    label="PLG_SYSTEM_GOOGLEAUTH_FIELD_CLIENT_ID_LABEL" />

                <field
                    name="client_secret"
                    type="password"
                    label="PLG_SYSTEM_GOOGLEAUTH_FIELD_CLIENT_SECRET_LABEL" />
            </fieldset>

            <fieldset
                name="appearance"
                label="PLG_SYSTEM_GOOGLEAUTH_FIELDSET_APPEARANCE">

                <field
                    name="button_theme"
                    type="list"
                    label="PLG_SYSTEM_GOOGLEAUTH_BUTTON_THEME_LABEL"
                    description="PLG_SYSTEM_GOOGLEAUTH_BUTTON_THEME_DESC"
                    default="light">
                    <option value="light">PLG_SYSTEM_GOOGLEAUTH_BUTTON_THEME_LIGHT</option>
                    <option value="classic">PLG_SYSTEM_GOOGLEAUTH_BUTTON_THEME_CLASSIC</option>
                    <option value="dark">PLG_SYSTEM_GOOGLEAUTH_BUTTON_THEME_DARK</option>
                    <option value="neutral">PLG_SYSTEM_GOOGLEAUTH_BUTTON_THEME_NEUTRAL</option>
                </field>

                <field
                    name="button_type"
                    type="list"
                    label="PLG_SYSTEM_GOOGLEAUTH_BUTTON_TYPE_LABEL"
                    description="PLG_SYSTEM_GOOGLEAUTH_BUTTON_TYPE_DESC"
                    default="standard">
                    <option value="standard">PLG_SYSTEM_GOOGLEAUTH_BUTTON_TYPE_STANDARD</option>
                    <option value="icon">PLG_SYSTEM_GOOGLEAUTH_BUTTON_TYPE_ICON</option>
                </field>

                <field
                    name="icon_align"
                    type="list"
                    label="PLG_SYSTEM_GOOGLEAUTH_ICON_ALIGN_LABEL"
                    description="PLG_SYSTEM_GOOGLEAUTH_ICON_ALIGN_DESC"
                    default="left"
                    showon="button_type:icon">
                    <option value="left">PLG_SYSTEM_GOOGLEAUTH_ICON_ALIGN_LEFT</option>
                    <option value="center">PLG_SYSTEM_GOOGLEAUTH_ICON_ALIGN_CENTER</option>
                    <option value="right">PLG_SYSTEM_GOOGLEAUTH_ICON_ALIGN_RIGHT</option>
                </field>

                <field
                    name="icon_match_height"
                    type="radio"
                    label="PLG_SYSTEM_GOOGLEAUTH_ICON_MATCH_HEIGHT_LABEL"
                    description="PLG_SYSTEM_GOOGLEAUTH_ICON_MATCH_HEIGHT_DESC"
                    default="1"
                    layout="joomla.form.field.radio.switcher"
                    showon="button_type:icon">
                     <option value="0">JNO</option>
                     <option value="1">JYES</option>
                </field>

                <field
                    name="button_shape"
                    type="list"
                    label="PLG_SYSTEM_GOOGLEAUTH_BUTTON_SHAPE_LABEL"
                    description="PLG_SYSTEM_GOOGLEAUTH_BUTTON_SHAPE_DESC"
                    default="rectangular">
                    <option value="rectangular">PLG_SYSTEM_GOOGLEAUTH_BUTTON_SHAPE_RECTANGULAR</option>
                    <option value="pill">PLG_SYSTEM_GOOGLEAUTH_BUTTON_SHAPE_PILL</option>
                </field>

                <field
                    name="match_submit_style"
                    type="radio"
                    label="PLG_SYSTEM_GOOGLEAUTH_MATCH_SUBMIT_LABEL"
                    description="PLG_SYSTEM_GOOGLEAUTH_MATCH_SUBMIT_DESC"
                    default="0"
                    layout="joomla.form.field.radio.switcher">
                     <option value="0">JNO</option>
                     <option value="1">JYES</option>
                </field>
            </fieldset>

            <fieldset
                name="redirects"
                label="PLG_SYSTEM_GOOGLEAUTH_FIELDSET_REDIRECT">

                <field
                    name="redirect_login"
                    type="list"
                    label="PLG_SYSTEM_GOOGLEAUTH_REDIRECT_LOGIN_LABEL"
                    description="PLG_SYSTEM_GOOGLEAUTH_REDIRECT_LOGIN_DESC"
                    default="current">
                    <option value="current">PLG_SYSTEM_GOOGLEAUTH_REDIRECT_CURRENT</option>
                    <option value="profile">PLG_SYSTEM_GOOGLEAUTH_REDIRECT_PROFILE</option>
                    <option value="home">PLG_SYSTEM_GOOGLEAUTH_REDIRECT_HOME</option>
                    <option value="custom">PLG_SYSTEM_GOOGLEAUTH_REDIRECT_CUSTOM</option>
                </field>

                <field
                    name="redirect_login_url"
                    type="text"
                    label="PLG_SYSTEM_GOOGLEAUTH_REDIRECT_LOGIN_URL_LABEL"
                    description="PLG_SYSTEM_GOOGLEAUTH_REDIRECT_URL_DESC"
                    hint="/profile"
                    filter="string"
                    showon="redirect_login:custom" />

                <field
                    name="redirect_register"
                    type="list"
                    label="PLG_SYSTEM_GOOGLEAUTH_REDIRECT_REGISTER_LABEL"
                    description="PLG_SYSTEM_GOOGLEAUTH_REDIRECT_REGISTER_DESC"
                    default="same">
                    <option value="same">PLG_SYSTEM_GOOGLEAUTH_REDIRECT_SAME</option>
                    <option value="current">PLG_SYSTEM_GOOGLEAUTH_REDIRECT_CURRENT</option>
                    <option value="profile">PLG_SYSTEM_GOOGLEAUTH_REDIRECT_PROFILE</option>
                    <option value="home">PLG_SYSTEM_GOOGLEAUTH_REDIRECT_HOME</option>
                    <option value="custom">PLG_SYSTEM_GOOGLEAUTH_REDIRECT_CUSTOM</option>
                </field>

                <field
                    name="redirect_register_url"
                    type="text"
                    label="PLG_SYSTEM_GOOGLEAUTH_REDIRECT_REGISTER_URL_LABEL"
                    description="PLG_SYSTEM_GOOGLEAUTH_REDIRECT_URL_DESC"
                    hint="/profile"
                    filter="string"
                    showon="redirect_register:custom" />
            </fieldset>

            <fieldset
                name="privacy"
                label="PLG_SYSTEM_GOOGLEAUTH_FIELDSET_PRIVACY">

                <field
                    name="require_consent"
                    type="radio"
                    label="PLG_SYSTEM_GOOGLEAUTH_REQUIRE_CONSENT_LABEL"
                    description="PLG_SYSTEM_GOOGLEAUTH_REQUIRE_CONSENT_DESC"
                    default="1"
                    layout="joomla.form.field.radio.switcher">
                     <option value="0">JNO</option>
                     <option value="1">JYES</option>
                </field>

                <field
                    name="force_google_consent"
                    type="radio"
                    label="PLG_SYSTEM_GOOGLEAUTH_FORCE_GOOGLE_CONSENT_LABEL"
                    description="PLG_SYSTEM_GOOGLEAUTH_FORCE_GOOGLE_CONSENT_DESC"
                    default="1"
                    layout="joomla.form.field.radio.switcher">
                     <option value="0">JNO</option>
                     <option value="1">JYES</option>
                </field>

                <field
                    name="privacy_link"
                    type="url"
                    label="PLG_SYSTEM_GOOGLEAUTH_FIELD_PRIVACY_LINK_LABEL" />

                <field
                    name="terms_link"
                    type="url"
                    label="PLG_SYSTEM_GOOGLEAUTH_FIELD_TERMS_LINK_LABEL" />

                <field
                    name="privacy_version"
                    type="text"
                    label="PLG_SYSTEM_GOOGLEAUTH_FIELD_PRIVACY_VERSION_LABEL"
                    description="PLG_SYSTEM_GOOGLEAUTH_FIELD_PRIVACY_VERSION_DESC"
                    default="2026-07-23" />

                <field
                    name="terms_version"
                    type="text"
                    label="PLG_SYSTEM_GOOGLEAUTH_FIELD_TERMS_VERSION_LABEL"
                    description="PLG_SYSTEM_GOOGLEAUTH_FIELD_TERMS_VERSION_DESC"
                    default="2026-07-23" />
            </fieldset>

            <fieldset
                name="notifications"
                label="PLG_SYSTEM_GOOGLEAUTH_FIELDSET_NOTIFICATIONS">

                <field
                    name="notify_admins"
                    type="radio"
                    label="PLG_SYSTEM_GOOGLEAUTH_NOTIFY_ADMINS_LABEL"
                    description="PLG_SYSTEM_GOOGLEAUTH_NOTIFY_ADMINS_DESC"
                    default="0"
                    layout="joomla.form.field.radio.switcher">
                     <option value="0">JNO</option>
                     <option value="1">JYES</option>
                </field>

                <field
                    name="admin_notify_ids"
                    type="text"
                    label="PLG_SYSTEM_GOOGLEAUTH_ADMIN_NOTIFY_IDS_LABEL"
                    description="PLG_SYSTEM_GOOGLEAUTH_ADMIN_NOTIFY_IDS_DESC"
                    hint="1, 42"
                    filter="string"
                    showon="notify_admins:1" />
            </fieldset>
        </fields>
    </config>

    <updateservers>
        <server type="extension" priority="1" name="Google Auth Plugin Updates">
            https://raw.githubusercontent.com/TommiLin/Google-Auth-Login-Joomla-Plugin/main/updates.xml
        </server>
    </updateservers>
</extension>
